{
  "name": "game-rating-site",
  "version": "1.0.0",
  "description": "本地运行的 AI 游戏评分网站",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:db:create": "wrangler d1 create game-rating-db",
    "cf:db:migrate": "wrangler d1 migrations apply game-rating-db --remote"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
